PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@AURA_CLUSTER_HOST/aura_db?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=aura-transport-images
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-public-r2-or-custom-domain
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=100

# Single-admin authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=aura_admin_token
ADMIN_USERNAME=auraadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
